# Environment Configuration Template for Moat Policy Chat Bot
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.template .env
# 2. Replace placeholder values (e.g., <YOUR_KEY_HERE>) with actual credentials
# 3. At minimum, configure ONE LLM provider (OpenAI, Azure OpenAI, or Local)
#
# SECURITY WARNING: Never commit the .env file with actual API keys to version control!

# =============================================================================
# LLM PROVIDERS (Configure at least ONE)
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI Configuration (Recommended)
# -----------------------------------------------------------------------------
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=<YOUR_OPENAI_KEY>
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large

# -----------------------------------------------------------------------------
# Azure OpenAI Configuration (Alternative to OpenAI)
# -----------------------------------------------------------------------------
# Get credentials from Azure Portal
AZURE_OPENAI_ENDPOINT=<YOUR_AZURE_ENDPOINT>
AZURE_OPENAI_API_KEY=<YOUR_AZURE_API_KEY>
OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=text-embedding-3-large

# -----------------------------------------------------------------------------
# Local Models (Alternative - requires Ollama server running)
# -----------------------------------------------------------------------------
# Install Ollama: https://ollama.ai/
# Then run: ollama pull qwen2.5:7b && ollama pull nomic-embed-text
LOCAL_MODEL=qwen2.5:7b
LOCAL_MODEL_EMBEDDINGS=nomic-embed-text
KH_OLLAMA_URL=http://localhost:11434/v1/

# =============================================================================
# OPTIONAL: Additional LLM Providers
# =============================================================================

# Cohere
COHERE_API_KEY=<COHERE_API_KEY>

# Mistral
# MISTRAL_API_KEY=<MISTRAL_API_KEY>

# VoyageAI (for embeddings)
VOYAGE_API_KEY=<VOYAGE_API_KEY>

# =============================================================================
# OPTIONAL: Advanced Features
# =============================================================================

# -----------------------------------------------------------------------------
# GraphRAG Configuration (Graph-based Retrieval - Enhanced reasoning)
# -----------------------------------------------------------------------------
GRAPHRAG_API_KEY=<YOUR_OPENAI_KEY>
GRAPHRAG_LLM_MODEL=gpt-4o-mini
GRAPHRAG_EMBEDDING_MODEL=text-embedding-3-small
USE_CUSTOMIZED_GRAPHRAG_SETTING=false

# -----------------------------------------------------------------------------
# Document Processing (Advanced PDF/Document parsing)
# -----------------------------------------------------------------------------

# Azure Document Intelligence
AZURE_DI_ENDPOINT=
AZURE_DI_CREDENTIAL=

# Adobe PDF Services
# Get free credential at: https://acrobatservices.adobe.com/dc-integration-creation-app-cdn/main.html?api=pdf-extract-api
PDF_SERVICES_CLIENT_ID=
PDF_SERVICES_CLIENT_SECRET=

# =============================================================================
# OPTIONAL: Authentication & Security
# =============================================================================

# PDF.js Configuration (for in-browser PDF viewer)
PDFJS_VERSION_DIST=pdfjs-4.0.379-dist

# Authentication Method Selection
# Leave empty for Google OAuth, set to "KEYCLOAK" for Keycloak
# NOTE: User management is currently DISABLED (KH_FEATURE_USER_MANAGEMENT=False)
AUTHENTICATION_METHOD=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Keycloak Configuration
KEYCLOAK_SERVER_URL=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_SECRET=

# =============================================================================
# Application Settings (Usually don't need to change these)
# =============================================================================

# Server Configuration (defined in docker-compose.yml / docker-stack.yml)
# GRADIO_SERVER_NAME=0.0.0.0
# GRADIO_SERVER_PORT=7860
# GR_FILE_ROOT_PATH=/app
# KH_APP_DATA_DIR=/app/ktem_app_data

# Feature Flags (defined in flowsettings.py)
# KH_FEATURE_USER_MANAGEMENT=false  # User login disabled
# KH_SSO_ENABLED=false              # SSO disabled
# KH_DEMO_MODE=false                # Not in demo mode
# USE_LIGHTRAG=true                 # Graph-based retrieval enabled
